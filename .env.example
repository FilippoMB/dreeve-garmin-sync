# Required: absolute path to the existing watch/ directory used by Dreeve v5.
DREEVE_WATCH_DIR=

# Required: earliest Garmin activity date to scan, in YYYY-MM-DD format.
GARMIN_SYNC_START_DATE=

# Required: nonzero numeric owner of both writable host directories. Usually
# `id -u` and `id -g` for the non-root account that runs Docker Compose.
GARMIN_SYNC_UID=
GARMIN_SYNC_GID=

# Connector-owned state, token, archive, and quarantine directory.
GARMIN_SYNC_DATA_PATH=./data

# Optional runtime settings.
GARMIN_SYNC_INTERVAL_MINUTES=60
GARMIN_SYNC_OVERLAP_DAYS=2
GARMIN_SYNC_LOG_LEVEL=INFO
TZ=Etc/UTC
